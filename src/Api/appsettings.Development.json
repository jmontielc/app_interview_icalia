{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=AppInterview;User Id=sa;Password=Local_Dev_Only!123;TrustServerCertificate=True"
  },
  "Auth": {
    "DevUserPassword": "Local-Dev-Password-1!",
    "Jwt": {
      "Issuer": "app-interview-local",
      "Audience": "app-interview-web",
      "SigningKey": "local-dev-only-signing-key-not-for-production-0123456789",
